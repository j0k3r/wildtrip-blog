{
  "name": "wildtrip.blog",
  "version": "1.0.0",
  "description": "Jeremy's travel blog",
  "type": "module",
  "packageManager": "yarn@1.22.22",
  "scripts": {
    "build": "yarn eleventy && yarn pagefind --site _site",
    "start": "yarn eleventy --serve --quiet",
    "debug": "cross-env DEBUG=Eleventy* yarn eleventy",
    "lint": "biome check"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/j0k3r/wildtrip-blog.git"
  },
  "author": {
    "name": "Jeremy Benoist",
    "url": "https://www.j0k3r.net/"
  },
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "homepage": "https://github.com/j0k3r/wildtrip-blog#readme",
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "@11ty/eleventy-img": "^7.0.0",
    "@11ty/eleventy-navigation": "^1.0.5",
    "@11ty/eleventy-plugin-rss": "^3.0.0",
    "@biomejs/biome": "2.5.12",
    "cross-env": "^10.1.0",
    "dayjs": "^1.11.23",
    "pagefind": "^1.5.2",
    "zod": "^4.4.3",
    "zod-validation-error": "^5.0.0"
  },
  "dependencies": {
    "netlify-plugin-cache": "^1.0.3"
  }
